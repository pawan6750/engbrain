# Copy to .env — never commit real values
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Supported providers: gemini, groq, openai, mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Leave Hindsight unset to use local SQLite memory with no Hindsight service or billing.
HINDSIGHT_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK=engbrain
